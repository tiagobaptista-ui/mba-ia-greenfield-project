    "/auth/logout": {
      "post": {
        "description": "Revokes all active refresh tokens for the authenticated user.",
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Logged out successfully"
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Log out",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "description": "Returns the authenticated user's profile from the JWT payload.",
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current user payload",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "sub": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get current user",
        "tags": [
          "auth"
        ]
      }
    },
    "/videos": {
      "post": {
        "description": "Pre-registers the video as a draft in the caller channel and opens an S3 multipart upload. The client then uploads each part directly to the object storage using presigned URLs — the file never passes through the API.",
        "operationId": "VideosController_initiateUpload",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVideoDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created with its upload plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InitiatedUploadResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR, UNSUPPORTED_VIDEO_FORMAT (mp4, webm, mov, mkv only) or VIDEO_TOO_LARGE (> 10 GiB)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Start a video upload",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{id}/upload/part-urls": {
      "get": {
        "description": "Returns presigned UploadPart URLs (up to 100 per call). The client PUTs each part to its URL and keeps the returned ETag.",
        "operationId": "VideosController_signPartUrls",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "part_numbers",
            "required": true,
            "in": "query",
            "description": "Comma-separated part numbers, e.g. `1,2,3` (max 100 per request).",
            "schema": {
              "minItems": 1,
              "uniqueItems": true,
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 1
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Presigned part URLs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartUrlsResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR or INVALID_PART_NUMBER",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "403": {
            "description": "VIDEO_ACCESS_DENIED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "VIDEO_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "INVALID_VIDEO_STATE — the video is not a draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Sign part upload URLs",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{id}/upload/complete": {
      "post": {
        "description": "Completes the multipart upload, checks the real object size and enqueues the background processing (duration, metadata, thumbnail).",
        "operationId": "VideosController_completeUpload",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteUploadDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Upload completed; processing enqueued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompletedUploadResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR, INVALID_UPLOAD_PARTS or UPLOAD_SIZE_MISMATCH (video marked failed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "403": {
            "description": "VIDEO_ACCESS_DENIED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "VIDEO_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "INVALID_VIDEO_STATE — the video is not a draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Complete a video upload",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{id}/upload": {
      "delete": {
        "description": "Aborts the multipart upload in progress and removes the draft video.",
        "operationId": "VideosController_abortUpload",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Upload aborted, draft removed"
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "403": {
            "description": "VIDEO_ACCESS_DENIED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "VIDEO_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "INVALID_VIDEO_STATE — the video is not a draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Abort a video upload",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{slug}/stream": {
      "get": {
        "description": "Redirects to a presigned GET of the original on the object storage, which answers `Range` requests with `206 Partial Content` — players seek without downloading the whole file.",
        "operationId": "VideosController_streamVideo",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the streamable original",
            "headers": {
              "Location": {
                "description": "Presigned object storage URL, valid for S3_PRESIGN_EXPIRES_SECONDS",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "404": {
            "description": "VIDEO_NOT_FOUND — unknown slug or the video is not ready (draft, processing or failed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many playback requests (120 per minute)"
          }
        },
        "summary": "Stream a video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{slug}/download": {
      "get": {
        "description": "Redirects to a presigned GET of the original served as `Content-Disposition: attachment` with the original file name.",
        "operationId": "VideosController_downloadVideo",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the original as an attachment",
            "headers": {
              "Location": {
                "description": "Presigned object storage URL, valid for S3_PRESIGN_EXPIRES_SECONDS",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "404": {
            "description": "VIDEO_NOT_FOUND — unknown slug or the video is not ready (draft, processing or failed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many playback requests (120 per minute)"
          }
        },
        "summary": "Download a video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{slug}/thumbnail": {
      "get": {
        "description": "Redirects to a presigned GET of the JPEG thumbnail generated by the video worker.",
        "operationId": "VideosController_getThumbnail",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the JPEG thumbnail",
            "headers": {
              "Location": {
                "description": "Presigned object storage URL, valid for S3_PRESIGN_EXPIRES_SECONDS",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "404": {
            "description": "VIDEO_NOT_FOUND — unknown slug or the video is not ready (draft, processing or failed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many playback requests (120 per minute)"
          }
        },
        "summary": "Get a video thumbnail",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{id}": {
      "get": {
        "description": "Returns the upload/processing status and the extracted metadata of a video owned by the caller.",
        "operationId": "VideosController_getOwnedVideo",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Video details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoDetailsResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "403": {
            "description": "VIDEO_ACCESS_DENIED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "VIDEO_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get an owned video",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "new_password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "new_password"
        ]
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {
          "file_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "size_bytes": {
            "type": "number",
            "description": "Declared size in bytes; values above 10 GiB are rejected with VIDEO_TOO_LARGE.",
            "minimum": 1
          },
          "content_type": {
            "type": "string",
            "description": "One of video/mp4, video/webm, video/quicktime, video/x-matroska.",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "description": "Defaults to the file name without extension.",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "file_name",
          "size_bytes",
          "content_type"
        ]
      },
      "VideoStatus": {
        "type": "string",
        "enum": [
          "draft",
          "processing",
          "ready",
          "failed"
        ]
      },
      "InitiatedUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "5b0c8a4e-6f7d-4a53-9b1e-2f4f0d6a9c11"
          },
          "slug": {
            "type": "string",
            "description": "Unique URL identifier (11-char base62)",
            "example": "aZ3kP9xQ2mB"
          },
          "title": {
            "type": "string",
            "example": "minha-viagem"
          },
          "status": {
            "example": "draft",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoStatus"
              }
            ]
          },
          "part_size_bytes": {
            "type": "number",
            "description": "Every part but the last has exactly this size",
            "example": 67108864
          },
          "part_count": {
            "type": "number",
            "example": 3
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "part_size_bytes",
          "part_count"
        ]
      },
      "SignedPartUrlDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Presigned UploadPart URL — PUT the part bytes and keep the ETag"
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "PartUrlsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignedPartUrlDto"
            }
          },
          "expires_in_seconds": {
            "type": "number",
            "example": 3600
          }
        },
        "required": [
          "parts",
          "expires_in_seconds"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "minimum": 1
          },
          "etag": {
            "type": "string",
            "description": "ETag returned by the storage for the part's PUT."
          }
        },
        "required": [
          "part_number",
          "etag"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {
          "parts": {
            "minItems": 1,
            "maxItems": 10000,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "CompletedUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "5b0c8a4e-6f7d-4a53-9b1e-2f4f0d6a9c11"
          },
          "slug": {
            "type": "string",
            "example": "aZ3kP9xQ2mB"
          },
          "title": {
            "type": "string",
            "example": "minha-viagem"
          },
          "status": {
            "example": "processing",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoStatus"
              }
            ]
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "status"
        ]
      },
      "VideoMetadataDto": {
        "type": "object",
        "properties": {
          "container": {
            "type": "string",
            "nullable": true,
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "video_codec": {
            "type": "string",
            "nullable": true,
            "example": "h264"
          },
          "audio_codec": {
            "type": "string",
            "nullable": true,
            "example": "aac"
          },
          "width": {
            "type": "number",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 1080
          },
          "fps": {
            "type": "number",
            "nullable": true,
            "example": 29.97
          },
          "bitrate": {
            "type": "number",
            "nullable": true,
            "description": "Bits per second",
            "example": 4500000
          }
        },
        "required": [
          "container",
          "video_codec",
          "audio_codec",
          "width",
          "height",
          "fps",
          "bitrate"
        ]
      },
      "VideoDetailsResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "5b0c8a4e-6f7d-4a53-9b1e-2f4f0d6a9c11"
          },
          "slug": {
            "type": "string",
            "example": "aZ3kP9xQ2mB"
          },
          "title": {
            "type": "string",
            "example": "minha-viagem"
          },
          "status": {
            "example": "ready",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoStatus"
              }
            ]
          },
          "original_file_name": {
            "type": "string",
            "example": "minha-viagem.mp4"
          },
          "content_type": {
            "type": "string",
            "example": "video/mp4"
          },
          "size_bytes": {
            "type": "number",
            "example": 137282022
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true,
            "description": "Set by the worker once the video is ready",
            "example": 60
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          },
          "has_thumbnail": {
            "type": "boolean",
            "description": "Whether GET /videos/:slug/thumbnail can serve an image"
          },
          "processing_error": {
            "type": "string",
            "nullable": true,
            "description": "Failure reason when status is failed",
            "example": null
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "original_file_name",
          "content_type",
          "size_bytes",
          "duration_seconds",
          "metadata",
          "has_thumbnail",
          "processing_error",
          "created_at",
          "updated_at"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}